#!/usr/bin/env node

/**
 * Claude Tracker Resume - Find crashed sessions and bring them back in Ghostty
 *
 * A crashed session is the newest transcript of a project (last 7 days) that
 * has no live Claude process, for projects with no live tab at all. Liveness
 * comes from ~/.claude/sessions/<pid>.json via tracker-utils.getLiveSessions().
 *
 * Usage:
 *   claude-tracker-resume                  List crashed sessions with resume commands
 *   claude-tracker-resume --open           Reopen each of them in a new Ghostty tab
 *   claude-tracker-resume --open --limit 3 Reopen at most 3
 *   claude-tracker-resume --dry-run        Show what --open would do
 *   claude-tracker-resume --days 14        Widen the window (default 7)
 *   claude-tracker-resume --workspace      Restore the stamped workspace (claude + codex
 *                                          Ghostty tabs from ~/.claude/workspace-state.json)
 *   claude-tracker-resume --workspace --dry-run
 */

const os = require('os');
const path = require('path');
const { execSync, spawnSync } = require('child_process');

const UTILS_PATH = path.join(os.homedir(), '.claude', 'lib', 'tracker-utils.js');
let utils;
try {
  utils = require(UTILS_PATH);
} catch (e) {
  console.error('Error: Could not load tracker utilities from ' + UTILS_PATH);
  process.exit(1);
}

const OPENER = path.join(os.homedir(), '.claude', 'scripts', 'ghostty-resume.sh');
const RESTORE_SCRIPT = path.join(os.homedir(), '.claude', 'skills', 'claude-tracker-suite', 'scripts', 'restore-workspace.sh');

// --- Argument parsing ---

function parseArgs(argv) {
  const args = { open: false, dryRun: false, workspace: false, limit: 10, days: 7, help: false };
  for (let i = 2; i < argv.length; i++) {
    const arg = argv[i];
    if (arg === '--help' || arg === '-h') args.help = true;
    else if (arg === '--open') args.open = true;
    else if (arg === '--dry-run') args.dryRun = true;
    else if (arg === '--workspace') args.workspace = true;
    else if (arg === '--all') { /* default now: every project, not only VS Code workspaces */ }
    else if (arg === '--tmux' || arg === '--zsh') {
      console.error(`Note: ${arg} is retired — sessions reopen in Ghostty (use --open)`);
      args.open = true;
    } else if (arg === '--limit' || arg === '-n') {
      const val = parseInt(argv[++i], 10);
      args.limit = (val > 0 && val <= 100) ? val : 10;
    } else if (arg === '--days') {
      const val = parseInt(argv[++i], 10);
      args.days = (val > 0 && val <= 365) ? val : 7;
    }
  }
  return args;
}

// --- Display ---

async function displaySessions(sessions) {
  const parsed = await Promise.all(sessions.map(s => utils.parseSession(s.filePath, { projectPath: s.projectPath })));

  for (let i = 0; i < sessions.length; i++) {
    const s = sessions[i];
    const p = parsed[i];
    const age = utils.formatAge(new Date(s.mtime).toISOString());
    const staleBadge = s.ageDays > 3 ? ' \x1b[43m\x1b[30m OLD \x1b[0m' : '';
    const title = (p && (p.customTitle || p.sessionSlug)) || '';

    console.log('\x1b[33m[' + (i + 1) + ']\x1b[0m \x1b[1m' + s.projectName + '\x1b[0m' + staleBadge +
      (title ? '  \x1b[35m' + title + '\x1b[0m' : ''));
    if (p && p.sessionSummary) console.log('    \x1b[90mSummary:\x1b[0m ' + p.sessionSummary);
    console.log('    \x1b[90mPath:\x1b[0m ' + s.projectPath);
    console.log('    \x1b[90mLast active:\x1b[0m ' + age);
    console.log('    \x1b[36mcd ' + s.projectPath + ' && claude --resume ' + s.sessionId + '\x1b[0m');
    console.log('    \x1b[35m' + OPENER + ' ' + s.sessionId + '\x1b[0m');
    console.log('');
  }
}

function openSessions(sessions, dryRun) {
  let opened = 0, failed = 0;
  for (const s of sessions) {
    if (dryRun) {
      console.log(`  [dry-run] ${s.projectName}: ${OPENER} ${s.sessionId} --project ${s.projectPath}`);
      continue;
    }
    const r = spawnSync(OPENER, [s.sessionId, '--project', s.projectPath],
      { stdio: ['ignore', 'inherit', 'inherit'], timeout: 20000 });
    if (r.status === 0) {
      opened++;
      console.log(`  \x1b[32m✓\x1b[0m Reopened \x1b[1m${s.projectName}\x1b[0m (${s.sessionId.slice(0, 8)})`);
      if (sessions.length > 1) spawnSync('sleep', ['1']);
    } else {
      failed++;
      console.error(`  \x1b[31m✗\x1b[0m ${s.projectName}: opener exited ${r.status}`);
    }
  }
  if (!dryRun) console.log(`\n${opened} reopened, ${failed} failed.`);
  return failed === 0;
}

// --- Main ---

async function main() {
  const args = parseArgs(process.argv);

  if (args.help) {
    console.log(`
Usage: claude-tracker-resume [options]

Find crashed Claude Code sessions (newest per project, no live process) and
reopen them in Ghostty tabs.

Options:
  --open            Reopen each crashed session in a new Ghostty tab
  --dry-run         Show what --open / --workspace would do
  --limit <n>       Max sessions (default: 10)
  --days <n>        Look-back window in days (default: 7)
  --workspace       Restore the stamped workspace (claude + codex tabs, TTY order)
  -h, --help        Show this help

Examples:
  claude-tracker-resume                     List crashed sessions with resume commands
  claude-tracker-resume --open              Reopen them all in Ghostty
  claude-tracker-resume --workspace         Bring back every tab from the last stamp
  claude-tracker-resume --workspace --dry-run
`);
    return;
  }

  if (args.workspace) {
    const extra = [];
    if (args.dryRun) extra.push('--dry-run');
    if (args.limit !== 10) extra.push('--limit', String(args.limit));
    const r = spawnSync('bash', [RESTORE_SCRIPT, ...extra], { stdio: 'inherit' });
    process.exit(r.status === null ? 1 : r.status);
  }

  const sessions = utils.getStaleSessions({ windowDays: args.days }).slice(0, args.limit);

  if (sessions.length === 0) {
    console.log('\x1b[32mNo crashed sessions found in the last ' + args.days + ' day(s).\x1b[0m');
    console.log('\x1b[90mEvery recent project has a live tab. Try --days 30 for older ones.\x1b[0m');
    return;
  }

  console.log('\n\x1b[1m\x1b[36m' + sessions.length + ' crashed session(s) found\x1b[0m \x1b[90m(newest per project, no live process)\x1b[0m\n');

  if (args.open || args.dryRun) {
    const ok = openSessions(sessions, args.dryRun);
    process.exit(ok ? 0 : 1);
  }

  await displaySessions(sessions);
  console.log('\x1b[90m───────────────────────────────────────────────────────────────\x1b[0m');
  console.log('\x1b[90mReopen all in Ghostty:\x1b[0m claude-tracker-resume --open');
  console.log('\x1b[90mRestore the full workspace:\x1b[0m claude-tracker-resume --workspace');
}

main().catch(e => {
  console.error('Error:', e.message);
  process.exit(1);
});
